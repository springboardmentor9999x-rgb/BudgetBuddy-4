# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Database ---
# For local development (SQLite):
DATABASE_URL=sqlite:///./budgetbuddy.db
# For production (PostgreSQL), use something like:
# DATABASE_URL=postgresql://budgetbuddy_user:password@localhost:5432/budgetbuddy

# --- Security / JWT ---
# Generate a strong random value, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_long_random_secret_value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# --- Frontend ---
FRONTEND_URL=http://localhost:5173

# --- CORS ---
# Comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# --- Email (SMTP) ---
# If MAIL_USERNAME/MAIL_PASSWORD/MAIL_FROM are left blank, the app prints the
# verification code / reset link to the backend console instead of failing
# signup (safe for local dev). Fill these in with real Gmail SMTP credentials
# for actual email delivery. This is the SMTP SENDER account (e.g.
# budgetbuddy01.team@gmail.com) - it is NOT the same thing as ADMIN_EMAIL below.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@budgetbuddy.app
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_FROM_NAME=BudgetBuddy

# --- SMS (optional) ---
# Leave SMS_PROVIDER blank to disable SMS entirely - messages are logged to
# the backend console instead of sent, and nothing crashes. Set to "twilio"
# and fill in the Twilio fields below to enable real SMS delivery.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Admin bootstrap ---
# Used by the create_admin.py helper script AND recognized by the backend
# at login/migration time as the one true Admin account. Keep this exact
# email if you want admin.budgetbuddy01@gmail.com to be your Admin login.
# This is DIFFERENT from MAIL_USERNAME above (that's the email SENDER).
ADMIN_EMAIL=admin.budgetbuddy01@gmail.com
ADMIN_PASSWORD=ChangeMe#123
ADMIN_NAME=BudgetBuddy Admin

# --- Demo accounts (optional) ---
# Used only by scripts/seed_demo_accounts.py. If left blank, safe defaults
# are used (see that script). Never used outside your local machine.
DEMO_NORMAL_PASSWORD=
DEMO_PREMIUM_PASSWORD=

# Gmail SMTP recommendation: port 465 + implicit TLS (MAIL_SSL_TLS=true, MAIL_STARTTLS=false)

